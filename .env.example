# Optional: leave both blank for full guest mode.
# The publishable key is browser-safe. Never use a database password, OAuth
# secret, Supabase secret/service-role key, or KEK in any VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Google Identity Services web client ID (public, never a client secret).
# Production `gis` uses direct Google ID-token sign-in. iOS requires redirect
# mode, so the same Google Web client must authorize https://gapwise.ca/ as a
# redirect URI. `oauth` is an explicit preview/debug fallback through Supabase.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_MODE=gis

# Optional private AI delegation bridge. Set this only to the trusted Gapwise AI
# service origin. Production uses https://ai.gapwise.ca.
VITE_GAPWISE_AI_URL=

# Private cloud storage is permanently encrypted-only in source. There is no
# VITE_PRIVATE_CLOUD_MODE rollout flag after the Gate 6 plaintext retirement.

# Server-only billing configuration. Never prefix these with VITE_. Checkout is
# fail-closed until STRIPE_CHECKOUT_ENABLED is exactly true; disabling it stops
# new/reused Checkout URLs while keeping the webhook active for refunds/disputes.
# Preview/test deployments may leave STRIPE_PRO_FALL_2026_PRICE_ID blank when
# using sk_test_*; the server then creates a fixed inline test price. Production
# must use the configured live catalog Price (currently price_1U6rzeQ8QLcLdoIzn6d7xosv).
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_FALL_2026_PRICE_ID=
STRIPE_CHECKOUT_ENABLED=false
