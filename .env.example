# Optional: leave both blank for full guest mode.
# The publishable key is browser-safe. Never use a database password, OAuth
# secret, or Supabase secret/service-role key in any VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Safe rollout gate: off = current production path, shadow = additive encrypted
# writes with legacy reads, encrypted = encrypted reads/writes only. Never set
# encrypted in production before every migration and KEK recovery gate passes.
VITE_PRIVATE_CLOUD_MODE=off
