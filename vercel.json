{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "trailingSlash": false,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10,
      "includeFiles": "src/data/utm/**"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.gapwise.ca" }],
      "destination": "https://gapwise.ca/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' blob: https://tiles.openfreemap.org https://accounts.google.com https://olrtvbblxbgcxbhvujaw.supabase.co wss://olrtvbblxbgcxbhvujaw.supabase.co https://ai.gapwise.ca; worker-src 'self'; frame-src https://accounts.google.com; frame-ancestors 'none'; object-src 'none'; media-src 'none'; manifest-src 'self'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sdk/gapwise-utm.d.ts",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/(favicon.svg|favicon-16x16.png|favicon-32x32.png|apple-touch-icon.png|icon-192.png|icon-512.png|site.webmanifest|robots.txt|sitemap.xml)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/today",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/timetable",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/gaps",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/route/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/oauth/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/v1",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/v1/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/_seo/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/places", "destination": "/_seo/places.html" },
    {
      "source": "/places/davis-food-court",
      "destination": "/_seo/places--davis-food-court.html"
    },
    {
      "source": "/places/utm-library",
      "destination": "/_seo/places--utm-library.html"
    },
    { "source": "/places/rawc", "destination": "/_seo/places--rawc.html" },
    { "source": "/developers", "destination": "/_seo/developers.html" },
    { "source": "/trust", "destination": "/_seo/trust.html" },
    { "source": "/privacy", "destination": "/_seo/privacy.html" },
    { "source": "/security", "destination": "/_seo/security.html" },
    { "source": "/accessibility", "destination": "/_seo/accessibility.html" },
    { "source": "/terms", "destination": "/_seo/terms.html" },
    { "source": "/v1", "destination": "/api/v1?resource=root" },
    { "source": "/v1/buildings", "destination": "/api/v1?resource=buildings" },
    {
      "source": "/v1/buildings/:building",
      "destination": "/api/v1?resource=building&building=:building"
    },
    { "source": "/v1/places", "destination": "/api/v1?resource=places" },
    {
      "source": "/v1/places/:placeId",
      "destination": "/api/v1?resource=place&placeId=:placeId"
    },
    { "source": "/v1/routes", "destination": "/api/v1?resource=routes" },
    { "source": "/v1/gaps/plan", "destination": "/api/v1?resource=gap-plan" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
