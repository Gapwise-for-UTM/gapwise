{
  "schemaVersion": 1,
  "self": "gapwise",
  "githubOrganization": "Gapwise-for-UTM",
  "canonical": {
    "app": "https://gapwise.ca",
    "api": "https://api.gapwise.ca/v1",
    "openapi": "https://api.gapwise.ca/openapi.json",
    "docs": "https://docs.gapwise.ca",
    "data": "https://data.gapwise.ca",
    "ai": "https://ai.gapwise.ca",
    "mcp": "https://ai.gapwise.ca/api/mcp",
    "status": "https://status.gapwise.ca"
  },
  "repositories": {
    "core": "https://github.com/Gapwise-for-UTM/gapwise",
    "mobile": "https://github.com/Gapwise-for-UTM/gapwise-mobile",
    "ai": "https://github.com/Gapwise-for-UTM/gapwise-ai",
    "data": "https://github.com/Gapwise-for-UTM/gapwise-data",
    "docs": "https://github.com/Gapwise-for-UTM/gapwise-docs",
    "status": "https://github.com/Gapwise-for-UTM/gapwise-status"
  },
  "ownership": {
    "core": [
      "student-state",
      "deterministic-domain-logic",
      "routing-algorithms",
      "gap-planning",
      "map-product-ui",
      "public-api",
      "openapi",
      "typescript-sdk",
      "python-sdk"
    ],
    "mobile": ["native-mobile-ux", "device-integration", "mobile-distribution"],
    "ai": ["oauth", "mcp", "delegation", "bounded-ai-actions"],
    "data": [
      "canonical-public-campus-facts",
      "campus-geometry",
      "entrances",
      "routing-graph-data",
      "provenance",
      "schemas",
      "evidence",
      "attribution",
      "validation",
      "reuse"
    ],
    "docs": ["released-developer-documentation"],
    "status": ["service-health", "incident-communication"]
  },
  "campusData": {
    "canonicalRepository": "https://github.com/Gapwise-for-UTM/gapwise-data",
    "canonicalPath": "data/utm",
    "coreMirrorPath": "src/data/utm",
    "runtimeFetchRequired": false,
    "syncMode": "vendored-build-time-snapshot"
  },
  "sdks": {
    "typescript": {
      "package": "@gapwise/sdk",
      "source": "sdk/javascript",
      "registries": {
        "npm": { "version": "0.1.1", "state": "published" },
        "jsr": { "version": "0.1.1", "state": "published" },
        "githubPackages": {
          "package": "@gapwise-for-utm/sdk",
          "version": "0.1.1",
          "state": "published",
          "role": "mirror"
        }
      },
      "runtimeTargets": ["node", "bun", "deno", "browser"],
      "model": "single-portable-implementation"
    },
    "python": {
      "package": "gapwise",
      "source": "sdk/python",
      "registries": {
        "pypi": { "version": "0.1.0", "state": "published" }
      },
      "clients": ["sync", "async"]
    }
  },
  "contract": {
    "publicApiVersion": "v1",
    "sourceOfTruth": "openapi-and-core-implementation",
    "sdkParityRequired": true,
    "privateStudentDataInPublicApi": false
  }
}
