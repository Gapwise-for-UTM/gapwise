{
  "name": "@gapwise/sdk",
  "version": "0.1.1",
  "description": "Official JavaScript and TypeScript client for the Gapwise public campus API",
  "author": {
    "name": "Andrew Muratov",
    "url": "https://github.com/andrewmuratov"
  },
  "keywords": [
    "gapwise",
    "utm",
    "campus",
    "routing",
    "openapi"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "pack:check": "bun pm pack --dry-run",
    "check": "bun run build && bun test && bun run pack:check",
    "prepack": "bun run build && bun test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewmuratov/gapwise.git",
    "directory": "sdk/javascript"
  },
  "bugs": "https://github.com/andrewmuratov/gapwise/issues",
  "homepage": "https://docs.gapwise.ca",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
