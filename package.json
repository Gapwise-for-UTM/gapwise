{
  "name": "gapwise-utm",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun scripts/build-seo-pages.ts && bun scripts/check-bundle-budget.ts",
    "bundle:check": "bun scripts/check-bundle-budget.ts",
    "contract:check": "bun scripts/check-public-contract.ts && python3 scripts/check-python-contract.py",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "bun audit --prod --audit-level=high",
    "survey:import": "bun scripts/import-campus-survey.ts",
    "survey:dry-run": "bun scripts/import-campus-survey.ts --dry-run",
    "routing:refresh": "bun scripts/generate-outdoor-routing.ts",
    "routing:audit": "bun scripts/audit-campus-routing.ts",
    "entrances:audit": "bun scripts/audit-campus-routing.ts",
    "routing:benchmark": "bun scripts/benchmark-routing.ts",
    "generate:icons": "bun scripts/generate-icons.ts",
    "model:stone": "bash scripts/apply-realistic-stone.sh"
  },
